[Unit]
Description=Calendario Ciclismo - coordinar emisiones oficiales y solicitudes manuales
Documentation=file:///opt/calendario-ciclismo/docs/runbooks/broadcasts-vps.md

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
RandomizedDelaySec=5s
Persistent=true
Unit=cc-broadcasts-sync.service

[Install]
WantedBy=timers.target
