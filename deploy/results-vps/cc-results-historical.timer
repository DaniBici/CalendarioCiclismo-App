[Unit]
Description=Calendario Ciclismo - comprobar resultados históricos cada cinco minutos
Documentation=file:///opt/calendario-ciclismo/docs/runbooks/results-vps.md

[Timer]
OnCalendar=*-*-* *:0/5:00
AccuracySec=5s
RandomizedDelaySec=15s
Persistent=true
Unit=cc-results-historical.service

[Install]
WantedBy=timers.target
