[Unit]
Description=Calendario Ciclismo - comprobar resultados UCI cada minuto
Documentation=file:///opt/calendario-ciclismo/docs/runbooks/uci-results-vps.md

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s
RandomizedDelaySec=5s
Persistent=true
Unit=cc-uci-results.service

[Install]
WantedBy=timers.target
