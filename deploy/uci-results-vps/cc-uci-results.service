[Unit]
Description=Calendario Ciclismo - sincronización configurada de resultados UCI
Documentation=file:///opt/calendario-ciclismo/docs/runbooks/uci-results-vps.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cc-results
Group=cc-results
WorkingDirectory=/opt/calendario-ciclismo
EnvironmentFile=/etc/calendario-ciclismo/uci-results.env
ExecStart=/usr/bin/node scripts/results-fetchers/uci-results-vps-runner.mjs
TimeoutStartSec=25min
RuntimeDirectory=cc-results
RuntimeDirectoryMode=0750
UMask=0077

# El proceso solo necesita red, lectura del checkout y escritura temporal.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
