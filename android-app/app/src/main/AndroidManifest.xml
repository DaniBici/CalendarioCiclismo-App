<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Factores de forma: solo teléfonos/tablets ───────────── -->
    <!-- Touchscreen requerido → excluye Android TV, Wear OS, Automotive, XR.
         android.software.leanback=false refuerza la exclusión de TV.
         Los android.hardware.type.* NO se declaran con required=false
         (Play Store lo rechaza); su ausencia ya indica que no se targeting. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.software.leanback"    android:required="false" />

    <!-- ── Permisos ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ (API 33): permiso runtime para mostrar notificaciones. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- WorkManager con constraint de batería / red -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".CalendarioCiclismoApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalendarioCiclismo"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasFragileUserData="true"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33">

        <!-- ── MainActivity — entry point Compose ──────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CalendarioCiclismo.Splash"
            android:windowSoftInputMode="adjustResize">

            <!-- ── Deep links HTTPS (App Links verificados) ─────
                 Requiere /.well-known/assetlinks.json en calendariociclismo.app
                 con el SHA-256 del keystore de release. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="calendariociclismo.app" />
                <data android:pathPattern="/competicion/.*" />
                <data android:pathPattern="/jornada/.*" />
                <data android:pathPattern="/mes.html" />
                <data android:pathPattern="/temporada.html" />
                <data android:pathPattern="/buscar.html" />
                <data android:pathPattern="/" />
            </intent-filter>

            <!-- ── Scheme custom `calendariociclismo://` ─────────
                 Usado por el widget "Hoy en el ciclismo" para abrir la app
                 en una jornada o pestaña concreta. El parser (DeepLink.fromUri)
                 acepta `race/{id}`, `stage/{id}`, `tab/{name}` y la forma corta
                 `{tabName}`. Ver docs/widget-hoy-en-el-ciclismo.md §7. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="calendariociclismo" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".LauncherDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherFounder"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_founder"
            android:roundIcon="@mipmap/ic_launcher_founder"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherFriend"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_friend"
            android:roundIcon="@mipmap/ic_launcher_friend"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ── Firebase Cloud Messaging ──────────────────────── -->
        <service
            android:name=".notifications.CCFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Canal de notificaciones por defecto (usado si el servidor no especifica channel_id) -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_default_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- ── WorkManager init — inicialización manual ────────
             Usamos Configuration.Provider en CalendarioCiclismoApp para
             controlar el logger y evitar auto-init. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- ── Widget "Hoy en el ciclismo" ──────────────────────
             GlanceAppWidgetReceiver que gestiona el ciclo de vida
             del widget y delega el renderizado a TodayCyclingWidget. -->
        <receiver
            android:name=".widget.today.TodayCyclingWidgetReceiver"
            android:label="@string/widget_today_title"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_cycling_widget_info" />
        </receiver>

        <!-- ── FileProvider ─────────────────────────────────────
             Expone los PDFs / imágenes descargados por el modo offline
             (carpeta OfflineAssets dentro de filesDir) para que puedan
             abrirse con la app predeterminada del sistema vía Intent VIEW.
             Android 7+ exige content:// URIs, no file://. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
