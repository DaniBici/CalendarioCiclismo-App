<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Theme base usado por la Activity antes de que Compose monte el
      CalendarioCiclismoTheme. Tema Material3 sin action bar; los colores
      se sobreescriben dentro de Compose.
    -->
    <!-- En modo claro fijamos windowLightStatusBar=true para que la barra de
         estado nazca con iconos OSCUROS antes de que Compose tome el control.
         Aunque enableEdgeToEdge() también lo gestiona, en algunos dispositivos
         (incluido Pixel 9a / API 35) el flag aplicado vía código queda en 0
         si el theme XML no lo declara primero. -->
    <style name="Theme.CalendarioCiclismo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- Barras transparentes: Material 3 hereda de AppCompat
             statusBarColor = colorPrimaryDark (lavanda #D0BCFF en oscuro,
             #6750A4 en claro), que core-splashscreen aplica en API 31-34. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Splash theme: la Activity arranca con este tema para que la core-splashscreen
      library muestre fondo + icono (calendario + bici) en todas las APIs.
      En API 31+ la librería delega al Splash Screen nativo del sistema.
      postSplashScreenTheme transiciona al tema Material3 real.
      Colores de values / values-night: en API 31+ siguen el modo noche de la
      app (UiModeManager.setApplicationNightMode); por debajo, el del sistema.
      El fondo del icono coincide con el de la pantalla para no dibujar círculo.
    -->
    <style name="Theme.CalendarioCiclismo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.CalendarioCiclismo</item>
    </style>
</resources>
