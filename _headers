# Cloudflare Pages — HTTP headers por ruta

# Panel: sin indexación (doble capa sobre auth)
/panel/*
  X-Robots-Tag: noindex, nofollow

# Páginas de detalle pre-renderizadas: indexación máxima
/jornada/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

/competicion/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

/inscritos/*
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1

# Assets estáticos del sitio (JS/CSS): cache de 1 h con revalidación.
# Captura la navegación multi-página de una sesión (home → carrera → inscritos →
# resultados reusan app.css/shared.js/… sin re-descargar) sin penalizar SEO (el
# HTML NO se cachea aquí → Cloudflare lo revalida y siempre sirve markup fresco).
# OJO: estos ficheros NO llevan hash en el nombre (no hay bundler), por eso NO se
# usa `immutable` — un deploy se propaga a quien vuelve en ≤1 h, y `must-revalidate`
# garantiza correctitud al expirar (ETag → 304 si no cambió). Para poder cachear
# con `immutable` haría falta un build step que hashee los nombres (app.<hash>.js).
/js/*
  Cache-Control: public, max-age=3600, must-revalidate
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

# Assets documentales en R2: sin indexación
/assets/*
  X-Robots-Tag: noindex

# Feeds iCal estáticos: MIME correcto + cache 6 h
# Sin Content-Disposition para que Safari ofrezca "Suscribirse" en vez de "Descargar"
/feed/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=21600, s-maxage=21600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

/feed/event/*.ics
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=21600, s-maxage=21600
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
