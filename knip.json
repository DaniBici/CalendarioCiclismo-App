{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "js/analytics.js",
        "js/apps-modal.js",
        "js/calendario.js",
        "js/campeonatos.js",
        "js/ciclocross.js",
        "js/competicion.js",
        "js/cookie-consent.js",
        "js/cx-race.js",
        "js/fichajes.js",
        "js/inscritos-pdf-app.js",
        "js/inscritos.js",
        "js/jornada.js",
        "js/lang-switch.js",
        "js/login.js",
        "js/mapa-pub.js",
        "js/orden-salida.js",
        "js/panel/main.js",
        "js/perfil-pub.js",
        "js/resultados.js",
        "js/theme.js",
        "sw.js",
        "js/__tests__/**/*.test.js",
        "scripts/__tests__/**/*.test.js",
        "scripts/**/*.{mjs,cjs,js}",
        "tools/**/*.mjs",
        "supabase/functions/**/index.ts"
      ],
      "project": [
        "js/**/*.{js,mjs}",
        "scripts/**/*.{mjs,cjs,js}",
        "tools/**/*.mjs",
        "supabase/functions/**/*.ts"
      ],
      "ignore": [
        "js/config.template.js"
      ],
      "ignoreDependencies": [
        "vite",
        "playwright"
      ]
    },
    "workers/og": {
      "project": [
        "src/**/*.js"
      ]
    },
    "workers/cyclocal": {
      "project": [
        "src/**/*.js"
      ],
      "ignoreDependencies": [
        "wrangler"
      ]
    }
  },
  "ignoreBinaries": [
    "wrangler"
  ]
}
